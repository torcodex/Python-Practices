class Bank:
    bank_name = "HDFC Bank"
    min_balance = 1000

    def __init__(self):
        self.name = ""
        self.__balance = 0
        print("Welcome to HDFC Bank")

    def create_account(self, name, balance, pin):
        if(balance < self.min_balance):
            print("Minimum Balance not met \n Account cannot be created!")
        else:
            self.__balance = balance
            self.name = name
            self.__pin = pin
            print(f"Account created with name {self.accname} \nWith an initial deposit of {self.__balance}")

    def check_balance(self):
        if(self.__balance < self.min_balance):
            print(f"Your balance {self.__balance} is less than minimum balance \nPlease deposit enough to be safely above the min balance")
        else:
            print(f"Your Balance is {self.__balance}")

    def deposit(self, deposit_amt):
        self.__balance += deposit_amt
        print(f"Your Balance is updated, \nDeposited an amount of {self.deposit_amt}")

    def withdraw(self, withdraw_amt):
        for i in range(3):
            if(self.__pin != input("Enter your PIN: ")):
                print("Invalid PIN")
            else:
                if(self.__balance < withdraw_amt):
                    print("Insufficient Balance")
                else:
                    self.__balance -= withdraw_amt
                    print(f"Your Balance is updated, \nWithdrawn an amount of {self.withdraw_amt}")
            if(i==2):
                print("You have exceeded the number of attempts")

    def get_pin(self):
        print("Be cautious!!, Do not reveal your PIN")
        print(f"Your PIN is {self.__pin}")

    def set_Pin(self,new_pin):
        print("Are you sure you want to update your account pin: Press \n'Y' for Yes \n'N' for No")
        if(input().capitalize() == 'Y'):
            self.__pin = new_pin
            print("Your PIN is updated")
        else:
            print("Your PIN updation is cancelled")
