class School:
    def __init__(self, name, age):
        self.name = name
        self.age = age

class student(School):
    def __init__(self, name, age, grade, Roll_num):
        super().__init__(name, age)
        self.grade = grade
        self.Roll_num = Roll_num

    def get_name(self):
        print(self.name)

    def get_age(self):
        print(self.age)

    def get_class(self):
        print(self.grade)

    def get_roll_num(self):
        print(self.Roll_num)

    def set_class(self, update = "annual", grade=0, result = True):
        if update == "annual":
            if result:
                self.grade+=1
                print(f"Student has been promoted to {self.grade}")
            else:
                print("Student has failed")
        else:
            if grade > self.grade and result:
                self.grade = grade
                print(f"Student has been promoted to {self.grade}")
            else:
                print("Student promotion failed")

    def set_name(self, new_name):
        self.name = new_name

class Teacher(School):
    def __init__(self, name, age, emp_num, salary):
        super().__init__(name, age)
        self.emp_num = emp_num
        self.salary = salary

    def get_name(self):
        print(self.name)

    def get_age(self):
        print(self.age)

    def get_emp_num(self):
        print(self.emp_num)

    def get_salary(self):
        print(self.salary)

    def set_salary(self, new_salary):
        self.salary += new_salary
        print(f"Salary is updated to {self.salary}")

    def set_name(self, new_name):
        self.name = new_name
