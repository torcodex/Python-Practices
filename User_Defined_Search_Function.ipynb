# In the search function input sentence (in which character/word is to be searched) and
# character/word input (which is to be searched in the sentence input)
# These two are mandatory inputs and cannot be skipped,
# If did, an error will occur when it is executed
# Other parameters are not mandatory as they have default values set!!

def search(ss, chr, start=0, end=0, finds="start", types="letter"):
# Trying to ensure that the Positional inputs of the users are correct
# so that the Program will run smoothly
# Because different Positional search needs different type of Positional input
# Which is essential for its proper working
    if end == 0:
        end = len(ss)
    if start > end and finds == "start":
        print("Invalid Position Input \nreseting start to 0th position \nend to last position")
        start = 0
        end = len(ss)
    elif start > end and finds == "end":
        print("Invalid Position Input \nreseting start to last position \nend to 0th position")
        start = len(ss)
        end = 0
    elif start > end and finds == "both":
        print("Invalid Position Input \nreseting start to 0th position \nend to last position")
        start = 0
        end = len(ss)
    elif start > end and finds == "all":
        print("Invalid Position Input \nreseting start to 0th position \nend to last position")
        start = 0
        end = len(ss)
    else:
        start = 0
        end = len(ss)

# Section for finding the letter that the user wants to find,
# from any given position - Starting, Ending, Both & All
# If none match correctly then it is a completely invalid input
    if types == "letter":
        if finds == "start":
            for i in range(start, end):
                if chr == ss[i]:
                    print(f"Found {chr} at Index {i}")
                    break
        elif finds == "end":
            for i in range(start-1,end-1, -1):
                if chr == ss[i]:
                    print(f"Found {chr} at Index {i}")
                    break
        elif finds == "both":
            found = False
            for i in range(start, end):
                if chr == ss[i] and found == False:
                    print(f"Found first {chr} at Index {i} &", end = " ")
                    found = True
            start = len(ss)
            end = 0
            for i in range(start-1,end-1, -1):
                if chr == ss[i]:
                    print(f"Found last {chr} at Index {i}")
                    break
        elif finds == 'all':
            for i in range(start, end):
                if chr == ss[i]:
                    print(f"Found {chr} at Index {i}")
        else:
            print("Invalid Input")

# Section for finding the Word that the user wants to find,
# from any given position - Starting, Ending, Both & All
# If none match correctly then it is a completely invalid input
    else:
        if finds == "start":
            for i in range(start, end):
                if chr[0] == ss[i]:
                    if chr == ss[i:i+len(chr)]:
                        print(f"Found {chr} from Index {i} to {i+len(chr)}")
                        break
        elif finds == "end":
            for i in range(start-1,end-1, -1):
                if chr[0] == ss[i]:
                    if chr == ss[i:i+len(chr)]:
                        print(f"Found {chr} from Index {i} to {i+len(chr)}")
                        break
        elif finds == "both":
            found = False
            for i in range(start, end):
                if chr[0] == ss[i] and found == False:
                    if chr == ss[i:i+len(chr)]:
                        print(f"Found first {chr} from Index {i} to {i+len(chr)}")
                        found = True
                        j = i
                        k = i+len(chr)
            start = len(ss)
            end = 0
            for i in range(start-1,end-1, -1):
                if chr[0] == ss[i]:
                    if chr == ss[i:i+len(chr)] and j!=i and k!=i+len(chr):
                        print(f"Found last {chr} from Index {i} to {i+len(chr)} ")
                        break
                    elif j==i and k==i+len(chr):
                        print("Only found one matching word!!")
                        break
        elif finds == 'all':
            for i in range(start, end):
                if chr[0] == ss[i]:
                    if chr == ss[i:i+len(chr)]:
                        print(f"Found {chr} from Index {i} to {i+len(chr)}")
# If the user has tried to select an option that is not available in the program,
# then it will cause an error
        else:
            print("Invalid Input")
